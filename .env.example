# Токен чат-бота MAX (выдан организаторами). Только на сервере, никогда в git/фронтенд/логи.
MAX_BOT_TOKEN=
# Секрет вебхука: 5–256 символов [a-zA-Z0-9-]. Приходит в заголовке X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=
# Режим получения событий: webhook (боевой, нужен PUBLIC_URL по HTTPS:443) | polling (локальная отладка) | none (только API и мини-приложение)
MAX_UPDATES_MODE=none
# Публичный HTTPS-адрес приложения (без завершающего слэша). Из него собираются ссылка мини-приложения и URL вебхука.
PUBLIC_URL=http://localhost:8080
# Порт HTTP-сервера внутри контейнера/на хосте
PORT=8080
# Каталог данных (SQLite-база, кэш источников, отчёты)
DATA_DIR=./data
# Секрет подписи сессий мини-приложения: случайная строка ≥16 символов (openssl rand -hex 32). Обязателен в режимах webhook/polling.
SESSION_SECRET=
# Базовый адрес Bot API MAX (по умолчанию platform-api2.max.ru; требует доверия к сертификату Минцифры)
MAX_API_BASE=https://platform-api2.max.ru
# Дополнительные корневые сертификаты (сертификат Минцифры для platform-api2.max.ru)
NODE_EXTRA_CA_CERTS=./server/certs/russian_trusted_bundle.pem
# Уровень логов: info | debug
LOG_LEVEL=info
# Чьим заголовкам X-Forwarded-For верить при определении IP клиента (лимиты демо-режима):
# список адресов/CIDR через запятую, true — всем (небезопасно без прокси), false — никому.
# Пусто — только loopback (127.0.0.1,::1): nginx на том же хосте.
TRUST_PROXY=
# Год плана проверок ЕРКНМ (Генпрокуратура). По умолчанию — текущий.
ERKNM_YEAR=
# Через сколько дней проверять, не вышла ли новая версия набора ЕРКНМ
ERKNM_MAX_AGE_DAYS=7

# --- Необязательные параметры: значения по умолчанию подходят для проверки, менять не нужно ---
# Адрес прослушивания. По умолчанию 0.0.0.0 в Docker (DATA_DIR=/data) и 127.0.0.1 при локальном запуске.
HOST=
# Порт на хосте для compose.yaml (проброс HOST_PORT:8080)
HOST_PORT=8080
# Каталог пакетов контекста (в Docker — /app/packs)
PACKS_DIR=
# Свежесть кэша вакансий, часов
VACANCY_CACHE_HOURS=6
# Свежесть профиля из реестра МСП, часов (720 = 30 суток)
PROFILE_CACHE_HOURS=720
# Сколько записей вакансий максимум забирать у источника на один запрос
MAX_VACANCY_RECORDS=2000
# Сколько ИНН работодателей обогащать через реестр МСП на одну карточку
MAX_EMPLOYERS_TO_ENRICH=60
