{
  "name": "@stavka/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сервер «Ставки»: чат-бот MAX, API мини-приложения, движок рынка труда, интеграции с госисточниками",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "packs:validate": "tsx src/packs/validate-cli.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@maxhub/max-bot-api": "0.3.1",
    "fastify": "^5.6.0",
    "pdfkit": "^0.17.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
